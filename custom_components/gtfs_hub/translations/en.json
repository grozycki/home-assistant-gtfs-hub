      }
    },
    "stop": {
      "entry_type": "Stop",
      "initiate_flow": {
        "user": "Add stop"
      },
      "step": {
        "user": {
          "title": "Find a stop of your lines",
          "data": {
            "query": "Name or code"
          }
        },
        "pick": {
          "title": "Choose a stop",
          "data": {
            "stop": "Stop"
          }
        }
      },
      "error": {
        "no_matches": "No matching stop on your lines."
      },
      "abort": {
        "already_configured": "This stop is already added.",
        "entry_not_loaded": "The source is not loaded.",
        "no_lines": "Add a line first, and wait for its schedule to download."
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Nearest stop",
        "description": "Each chosen person gets a sensor showing the closest stop of your lines.",
        "data": {
          "persons": "Persons"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "next_departure": {
        "name": "Next departure"
