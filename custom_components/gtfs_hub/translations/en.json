      },
      "generic": {
        "title": "GTFS from URLs",
        "description": "The schedule must be a GTFS ZIP file.",
        "data": {
          "schedule_url": "Schedule URL",
          "trip_updates_url": "Trip updates URL (optional)"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the source.",
