      }
    }
  },
  "config_subentries": {
    "line": {
      "entry_type": "Line",
      "initiate_flow": {
        "user": "Add line"
      },
      "step": {
        "user": {
          "title": "Find a line",
          "data": {
            "query": "Number or name"
          }
        },
        "pick": {
          "title": "Choose a line",
          "data": {
            "line": "Line"
          }
        }
      },
      "error": {
        "no_matches": "Nothing found."
      },
      "abort": {
        "already_configured": "This line is already added.",
        "entry_not_loaded": "The source is not loaded.",
